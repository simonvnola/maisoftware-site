{
  "redirects": [
    { "source": "/maiconflicts",                       "destination": "/", "permanent": false },
    { "source": "/maiconflicts/(.*)",                  "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
