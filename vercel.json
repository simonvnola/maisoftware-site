{
  "redirects": [
    {
      "source": "/maiconflicts",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/maiconflicts/(.*)",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/guide",
      "destination": "/api/guide"
    },
    {
      "source": "/ubi",
      "destination": "/UBI/index.html"
    },
    {
      "source": "/ubi/:path*",
      "destination": "/UBI/:path*"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
