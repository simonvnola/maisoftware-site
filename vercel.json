{
  "redirects": [
    {
      "source": "/maiconflicts",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/maiconflicts/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/ubi",
      "destination": "/UBI/",
      "permanent": true
    },
    {
      "source": "/ubi/(.*)",
      "destination": "/UBI/$1",
      "permanent": true
    },
    {
      "source": "/UBI/paper/10-appendix",
      "destination": "/UBI/paper/11-appendix/",
      "permanent": true
    },
    {
      "source": "/UBI/paper/10-appendix/(.*)",
      "destination": "/UBI/paper/11-appendix/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/guide",
      "destination": "/api/guide"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
